<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
  	<AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
  	<InfAppVersion Condition="'$(InfAppVersion)' == ''">$(AppVersion)</InfAppVersion>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>$(AppVersion)</Version>
    <FileVersion>$(AppVersion)</FileVersion>
    <InformationalVersion>$(InfAppVersion)</InformationalVersion>
    <Company>CoffeeStrap contributors</Company>
    <Product>CoffeeStrap</Product>
    <AssemblyName>CoffeeStrap</AssemblyName>
    <RootNamespace>Froststrap</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  	<!-- <PublishTrimmed>true</PublishTrimmed> -->
  	<NeutralLanguage>en</NeutralLanguage>
    <Description>CoffeeStrap - Roblox desktop launcher</Description>
    <ApplicationIcon>CoffeeStrap.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416;CA2007;CA1863;CA1031;CA1019;CA2000;CA1852;CA2216;CA1812;CA5392;SYSLIB1045;SYSLIB1054;CA5351</NoWarn>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('MacOS'))">$(DefineConstants);__APPLE__</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <SelfContained Condition="$(RuntimeIdentifier.StartsWith('win'))">false</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableCompressionInSingleFile Condition="$(RuntimeIdentifier.StartsWith('win'))">false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Resources needed by Avalonia -->
  <ItemGroup>
    <InternalsVisibleTo Include="CoffeeStrap.Preview" />
    <InternalsVisibleTo Include="CoffeeStrap.ThemeBuilder" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources/**" Exclude="Resources/**/*.resx;Resources/**/*.cs" />
    <AvaloniaResource Include="UI/AppThemes/EditorThemes/*.xshd" />
    <AvaloniaResource Include="Froststrap.ico" />
    <AvaloniaResource Include="Froststrap.png" />
    <AvaloniaResource Include="CoffeeStrap.ico" />
    <AvaloniaResource Include="CoffeeStrap.png" />
    <AvaloniaResource Include="UI\Elements\Base\BackgroundPanel.axaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Froststrap.ico" />
    <EmbeddedResource Include="Froststrap.png" />
    <EmbeddedResource Include="CoffeeStrap.ico" />
    <EmbeddedResource Include="CoffeeStrap.png" />
    <EmbeddedResource Include="Resources\**\*.*" Exclude="Resources\**\*.resx;Resources\**\*.cs;Resources\Fonts\**;Resources\BootstrapperStyles\**;Resources\MessageBox\**;Resources\CommunityMods\**;Resources\GlobalBasicSettings_Template.xml" />
    <EmbeddedResource Include="NLog.config">
      <LogicalName>NLog.config</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="AnimatedImage.Avalonia" Version="2.1.4" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.3" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.3" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.3" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="DotMake.CommandLine" Version="3.7.0" />
    <PackageReference Include="HotAvalonia" Version="3.1.5" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="ktsu.CredentialCache" Version="1.3.40" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12" PrivateAssets="all" IncludeAssets="none" GeneratePathProperty="true" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../libs/ColorPicker/ColorPicker.csproj" />
    <ProjectReference Include="../libs/LucideAvalonia/LucideAvalonia/LucideAvalonia.csproj" />
    <ProjectReference Include="../libs/FluentAvalonia/src/FluentAvalonia/FluentAvalonia.csproj" />
    <ProjectReference Include="../backend/backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Froststrap.Models.Attributes.BuildMetadataAttribute">
      <_Parameter1>$([System.DateTime]::UtcNow.ToString("s"))Z</_Parameter1>
      <_Parameter2>CoffeeStrap build</_Parameter2>
      <_Parameter3>$(CommitHash)</_Parameter3>
      <_Parameter4>$(CommitRef)</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources/Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources/Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="CopyMacLibsFromBackend" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">

    <PropertyGroup>
      <BackendOutDir>$(MSBuildProjectDirectory)/../backend/bin/$(Configuration)/$(TargetFramework)/</BackendOutDir>
    </PropertyGroup>

    <Copy SourceFiles="$(BackendOutDir)libvirtualdisplay.dylib" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(BackendOutDir)libvirtualdisplay.dylib')" />

    <Copy SourceFiles="$(BackendOutDir)libmobileappreg.dylib" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(BackendOutDir)libmobileappreg.dylib')" />

    <Copy SourceFiles="$(BackendOutDir)libnotify.dylib" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(BackendOutDir)libnotify.dylib')" />
  </Target>

  <Target Name="KeepDylibsOutOfBundle" AfterTargets="ComputeResolvedFilesToPublishList" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libnotify.dylib'&#xA;                                     Or '%(Filename)%(Extension)' == 'libvirtualdisplay.dylib'&#xA;                                     Or '%(Filename)%(Extension)' == 'libmobileappreg.dylib'" />
    </ItemGroup>
  </Target>

  <Target Name="OptimizeVerificationDependency" AfterTargets="PrepareForBundle" BeforeTargets="_GenerateSingleFileBundleInputCache"
          Condition="'$(PublishSingleFile)' == 'true' and $(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <_VerificationAssembly Include="@(FilesToBundle)" Condition="'%(Filename)%(Extension)' == 'BouncyCastle.Cryptography.dll'" />
    </ItemGroup>
    <Error Condition="'@(_VerificationAssembly)' == ''" Text="The signed-config verification dependency is missing." />
    <PropertyGroup>
      <_CryptoOutput>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)compact-crypto', '$(MSBuildProjectDirectory)'))</_CryptoOutput>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../build/windows/Optimize-Crypto.ps1&quot; -Assembly &quot;@(_VerificationAssembly)&quot; -Linker &quot;$(PkgMicrosoft_NET_ILLink_Tasks)/tools/net/illink.dll&quot; -Output &quot;$(_CryptoOutput)&quot;" />
    <ItemGroup>
      <FilesToBundle Remove="@(_VerificationAssembly)" />
      <FilesToBundle Include="$(_CryptoOutput)/BouncyCastle.Cryptography.dll">
        <RelativePath>BouncyCastle.Cryptography.dll</RelativePath>
      </FilesToBundle>
    </ItemGroup>
  </Target>
</Project>
