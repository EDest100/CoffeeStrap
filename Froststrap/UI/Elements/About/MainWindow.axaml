<base:AvaloniaWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:pages="clr-namespace:Froststrap.UI.Elements.About.Pages"
                     xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
                     xmlns:base="clr-namespace:Froststrap.UI.Elements.Base"
                     xmlns:resources="clr-namespace:Froststrap.Resources"
                     xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.About"
                     xmlns:ui="using:FluentAvalonia.UI.Controls"
                     xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
                     mc:Ignorable="d"
                     x:Class="Froststrap.UI.Elements.About.MainWindow"
                     x:DataType="vm:MainWindowViewModel"
                     Title="{x:Static resources:Strings.About_Title}"
                     MinWidth="740" Width="800" Height="560" MinHeight="440"
                     WindowStartupLocation="CenterScreen" CanResize="True">

    <Grid RowDefinitions="52,*" Background="{DynamicResource CoffeeChromeBrush}">
        <controls:TitleBar Title="CoffeeStrap" Icon="avares://CoffeeStrap/CoffeeStrap.png" Height="52" />

        <Grid Grid.Row="1" Name="MainGrid">
            <controls:CoffeeNavigationView Name="NavView"
                                 Background="{DynamicResource CoffeeChromeBrush}"
                                 OpenPaneLength="200"
                                 ItemInvoked="NavView_ItemInvoked">
                <controls:CoffeeNavigationView.MenuItems>
                    <controls:CoffeeNavigationItem Tag="about" Content="{x:Static resources:Strings.Menu_About_Title}">
                        <controls:CoffeeNavigationItem.Icon>
                            <ic:Lucide Icon="CircleAlert" Width="20" Height="20" />
                        </controls:CoffeeNavigationItem.Icon>
                    </controls:CoffeeNavigationItem>

                    <controls:CoffeeNavigationItem Tag="licenses" Content="{x:Static resources:Strings.About_Licenses_Title}">
                        <controls:CoffeeNavigationItem.Icon>
                            <ic:Lucide Icon="Copyright" Width="20" Height="20" />
                        </controls:CoffeeNavigationItem.Icon>
                    </controls:CoffeeNavigationItem>
                </controls:CoffeeNavigationView.MenuItems>

                <controls:CoffeeNavigationView.FooterMenuItems>
                    <controls:CoffeeNavigationItem Tag="onboarding" Content="{x:Static resources:Strings.About_Onboarding_Title}">
                        <controls:CoffeeNavigationItem.Icon>
                            <ic:Lucide Icon="Rocket" Width="20" Height="20" />
                        </controls:CoffeeNavigationItem.Icon>
                    </controls:CoffeeNavigationItem>
                </controls:CoffeeNavigationView.FooterMenuItems>

                <controls:CoffeeNavigationView.Content>
                    <TransitioningContentControl
                        x:Name="PageContentControl"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource LayerFillColorDefaultBrush}" />
                </controls:CoffeeNavigationView.Content>
            </controls:CoffeeNavigationView>
        </Grid>
    </Grid>
</base:AvaloniaWindow>
