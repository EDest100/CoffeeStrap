<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Froststrap.UI.Elements.Controls"
    xmlns:vm="using:Froststrap.UI.ViewModels.Onboarding"
    x:Class="Froststrap.UI.Elements.Onboarding.Pages.Page6"
    x:DataType="vm:Page6ViewModel">
    <controls:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="8,0,16,8">
            <TextBlock Text="A few useful details" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding FaqItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FaqItem">
                        <controls:CardExpander Header="{Binding Question}" IsExpanded="False">
                            <controls:MarkdownTextBlock MarkdownText="{Binding Answer}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </controls:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
