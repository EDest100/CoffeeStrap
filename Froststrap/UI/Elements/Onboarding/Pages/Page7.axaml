<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Froststrap.UI.ViewModels.Onboarding"
    xmlns:resources="using:Froststrap.Resources"
    xmlns:controls="using:Froststrap.UI.Elements.Controls"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    x:Class="Froststrap.UI.Elements.Onboarding.Pages.Page7"
    x:DataType="vm:Page7ViewModel">
    <controls:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,8" Spacing="16">
            <ic:Lucide x:Name="HeaderIcon" Icon="PartyPopper" Width="60" Height="60"
                HorizontalAlignment="Center" StrokeBrush="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" />
            <TextBlock Text="{x:Static resources:Strings.Common_Finished}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Static resources:Strings.Onboarding_Page7_Text1}" TextWrapping="Wrap"
                TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <controls:CardAction Header="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}"
                Icon="Gamepad2" Command="{Binding LaunchRobloxCommand}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <controls:CardAction Header="{x:Static resources:Strings.Common_Settings}" Icon="Settings" Command="{Binding LaunchSettingsCommand}" />
                <controls:DiscordButton Grid.Column="1" Width="56" Height="56" VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
