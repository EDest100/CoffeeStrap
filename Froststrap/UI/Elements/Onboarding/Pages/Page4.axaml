<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ui="using:FluentAvalonia.UI.Controls" xmlns:models="using:Froststrap.Models" xmlns:vm="using:Froststrap.UI.ViewModels.Onboarding" xmlns:resources="using:Froststrap.Resources" xmlns:controls="using:Froststrap.UI.Elements.Controls" xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600" x:Class="Froststrap.UI.Elements.Onboarding.Pages.Page4" x:DataType="vm:Page4ViewModel"><StackPanel Margin="16" Spacing="18"><TextBlock Text="Matchmaking" FontSize="24" FontWeight="Bold"/><TextBlock Text="Auto uses Roblox matchmaking. Preferred Region is available on Home; additional region providers are not enabled." TextWrapping="Wrap"/><Border Padding="20" CornerRadius="18" Background="{DynamicResource ControlFillColorDefaultBrush}"><TextBlock Text="Auto · Roblox matchmaking" FontWeight="SemiBold"/></Border></StackPanel></UserControl>
