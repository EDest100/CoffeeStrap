<base:AvaloniaWindow x:Class="Froststrap.UI.Elements.Dialogs.CommunityModInfoDialog"
 xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:base="clr-namespace:Froststrap.UI.Elements.Base" xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
 xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Dialogs" xmlns:models="clr-namespace:Froststrap.Models"
 x:DataType="vm:CommunityModInfoViewModel" Title="Mod preview" Width="720" MinWidth="360" MaxHeight="780" SizeToContent="Height" WindowStartupLocation="CenterOwner">
 <Grid Margin="20,4,20,20" RowDefinitions="*,Auto" RowSpacing="16">
  <ScrollViewer MaxHeight="610" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Spacing="14">
    <Border CornerRadius="14" ClipToBounds="True" Background="{DynamicResource CoffeeGroupBrush}">
     <Image Source="{Binding Mod.Thumbnail}" Stretch="Uniform" MaxHeight="330" RenderOptions.BitmapInterpolationMode="HighQuality" />
    </Border>
    <StackPanel Spacing="4">
     <TextBlock Text="{Binding Mod.Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
     <TextBlock Text="{Binding Mod.Author, StringFormat='Created by {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>
    <TextBlock Text="{Binding Mod.Description}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Mod.ApplyHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    <StackPanel IsVisible="{Binding ShowGlyphPreview}" Spacing="8">
     <TextBlock Text="Glyph preview" FontWeight="SemiBold" />
     <TextBlock Text="{Binding ColorDisplayText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
     <ItemsControl ItemsSource="{Binding GlyphItems}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:GlyphItem"><Border Width="36" Height="36" Margin="3" Padding="5" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"><Viewbox><Path Data="{Binding Data}" Fill="{Binding Brush}" /></Viewbox></Border></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
    <TextBlock Text="{Binding Mod.DownloadError}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    <ProgressBar IsVisible="{Binding Mod.IsDownloading}" Value="{Binding Mod.DownloadProgress}" Height="3" />
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
   <Button Content="{Binding Mod.DownloadLabel}" Command="{Binding Mod.DownloadCommand}" CommandParameter="{Binding Mod}" IsVisible="{Binding !Mod.IsInstalled}" IsEnabled="{Binding Mod.CanDownload}" HorizontalAlignment="Stretch" />
   <Grid IsVisible="{Binding Mod.IsInstalled}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <Button Content="{Binding Mod.ToggleLabel}" Command="{Binding Mod.ToggleCommand}" CommandParameter="{Binding Mod}" IsEnabled="{Binding !Mod.IsDownloading}" HorizontalAlignment="Stretch" />
    <Button Grid.Column="1" Content="Uninstall" Command="{Binding Mod.UninstallCommand}" CommandParameter="{Binding Mod}" IsEnabled="{Binding !Mod.IsDownloading}" />
   </Grid>
   <Button Grid.Column="1" Content="Close" Command="{Binding CloseCommand}" />
  </Grid>
 </Grid>
</base:AvaloniaWindow>
