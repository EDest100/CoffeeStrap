<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Froststrap.UI.Elements.Controls" xmlns:vm="using:Froststrap.UI.ViewModels.Settings" xmlns:mods="using:Froststrap.UI.Elements.Settings.Pages.Mods" xmlns:services="using:Froststrap.Services"
    x:Class="Froststrap.UI.Elements.Settings.Pages.ModsPresetsPage" x:DataType="vm:ModsPresetsViewModel">
    <controls:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="{DynamicResource CoffeePageMargin}" Spacing="24">
        <controls:ResponsiveCardGrid MinimumCardWidth="300" MaximumColumns="2">
            <controls:OptionControl Header="Cursor &amp; shift lock" Description="Preset or custom PNG, ICO, CUR or ANI images." Classes="stacked">
                <StackPanel Spacing="10"><ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CursorTypeTask.Selections}" SelectedItem="{Binding CursorTypeTask.NewState, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Content="Custom cursor" Command="{Binding AddCustomCursorModCommand}"/><Button Grid.Column="1" Content="Reset" Command="{Binding RestoreCursorCommand}" ToolTip.Tip="Restore default cursor"/></Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Content="Shift lock image" Command="{Binding AddCustomShiftlockModCommand}"/><Button Grid.Column="1" Content="Reset" Command="{Binding RemoveCustomShiftlockModCommand}" ToolTip.Tip="Restore default shift lock"/></Grid>
                </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="Game font" Description="Choose a TTF, OTF or TTC font." Classes="stacked"><StackPanel Spacing="10">
                <Button Command="{Binding ChooseCustomFontCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="46"><TextBlock Text="{Binding FontSelectionLabel}" TextTrimming="CharacterEllipsis"/></Button>
                <Button Content="Restore default" Command="{Binding RemoveCustomFontCommand}" HorizontalAlignment="Left"/>
            </StackPanel></controls:OptionControl>
            <controls:OptionControl Header="Emoji" Description="Choose the emoji set used in Roblox." Classes="stacked"><ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding EmojiFontTask.Selections}" SelectedItem="{Binding EmojiFontTask.NewState, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></controls:OptionControl>
            <controls:OptionControl Header="Death sound" Description="Use a custom OGG sound." Classes="stacked"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Content="Choose sound" Command="{Binding AddCustomDeathSoundCommand}"/><Button Grid.Column="1" Content="Reset" Command="{Binding RemoveCustomDeathSoundCommand}"/></Grid></controls:OptionControl>
        </controls:ResponsiveCardGrid>
        <controls:CardExpander Header="Last file-mod application" Description="Review actual file operations from the most recent CoffeeStrap player preparation." IsExpanded="False">
            <StackPanel DataContext="{Binding ApplicationReport}" x:DataType="vm:ModReportViewModel" Spacing="12">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                <WrapPanel><Button Content="Refresh report" Command="{Binding RefreshCommand}" Margin="0,0,12,6"/><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" IsVisible="{Binding HasReport}" MinWidth="180" Margin="0,0,0,6"/></WrapPanel>
                <TextBlock Text="{Binding Coverage}" IsVisible="{Binding HasReport}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="No recorded events match this filter." IsVisible="{Binding IsEmpty}" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding Entries}" IsVisible="{Binding HasEntries}" MaxHeight="360" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.Styles><ListBox.ItemTemplate><DataTemplate x:DataType="services:ModApplicationEvent">
                    <Border Padding="8,10" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                        <TextBlock Text="{Binding Source}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path}" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid></Border>
                </DataTemplate></ListBox.ItemTemplate></ListBox>
                <TextBlock Text="Default sky replacements can be overridden by a game's custom sky assets. A completed copy does not prove the game displayed that texture." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </controls:CardExpander>
        <mods:CommunityModsPage DataContext="{Binding Community}"/>
    </StackPanel></controls:SmoothScrollViewer>
</UserControl>
