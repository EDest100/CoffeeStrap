<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings"
    xmlns:models="clr-namespace:Froststrap.Models"
    xmlns:apis="clr-namespace:Froststrap.Models.APIs.Roblox"
    xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:resources="clr-namespace:Froststrap.Resources"
    xmlns:utility="clr-namespace:Froststrap.UI.Utility"
    x:Class="Froststrap.UI.Elements.Settings.Pages.QuickPlayPage"
    x:Name="RootPage"
    x:DataType="vm:QuickPlayViewModel">
<UserControl.Resources><DataTemplate x:Key="GameCardTemplate" x:DataType="models:QuickPlayGameItem"><controls:Card Padding="0" CornerRadius="20" ClipToBounds="True"><Grid RowDefinitions="150,Auto,Auto">
<Border Background="{DynamicResource CoffeeGroupBrush}" CornerRadius="20,20,0,0" ClipToBounds="True"><Grid><ic:Lucide Icon="Gamepad2" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /></Grid></Border>
<ToggleButton HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Width="34" Height="34" Padding="7" IsChecked="{Binding IsPinned, Mode=TwoWay}" AutomationProperties.Name="Pin to main menu" ToolTip.Tip="Pin to main menu"><ic:Lucide Icon="Star" Width="18" Height="18" /></ToggleButton>
<TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="14,12" />
<Button Grid.Row="2" Content="Play" Margin="12,0,12,12" Height="38" HorizontalAlignment="Stretch" Command="{Binding #RootPage.((vm:QuickPlayViewModel)DataContext).JoinGameCommand}" CommandParameter="{Binding}" />
</Grid></controls:Card></DataTemplate></UserControl.Resources>
<controls:SmoothScrollViewer><StackPanel Margin="{DynamicResource CoffeePageMargin}" Spacing="20"><AutoCompleteBox Grid.Column="0" x:Name="GameSearchAutoCompleteBox" HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}" ItemsSource="{Binding SearchResults}" FilterMode="None" IsDropDownOpen="{Binding IsSearchFlyoutOpen, Mode=TwoWay}" PlaceholderText="Search games or paste a Roblox link" MinHeight="48" Margin="0">
										<AutoCompleteBox.ItemTemplate>
											<DataTemplate DataType="apis:OmniSearchContent">
												<Grid ColumnDefinitions="Auto,*,Auto" MaxWidth="380">
													<Border Grid.Column="0" Width="44" Height="44" Background="#10FFFFFF" ClipToBounds="True" CornerRadius="4">
														<Image RenderOptions.BitmapInterpolationMode="LowQuality" Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
													</Border>
													<StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
														<TextBlock FontWeight="SemiBold" FontSize="16" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
														<TextBlock FontSize="10" Opacity="0.5" Text="{Binding RootPlaceId, StringFormat='ID: {0}'}"/>
													</StackPanel>
													<StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
														<ic:Lucide Margin="0,2,0,0" Height="12" Width="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Icon="Users"/>
														<TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding PlayerCount, Converter={StaticResource NumberAbbreviationConverter}}"/>
													</StackPanel>
												</Grid>
											</DataTemplate>
										</AutoCompleteBox.ItemTemplate>

										<AutoCompleteBox.InnerLeftContent>
											<ic:Lucide Icon="Search" Height="14" Width="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
										</AutoCompleteBox.InnerLeftContent>

										<AutoCompleteBox.InnerRightContent>
											<StackPanel Orientation="Horizontal" Spacing="4">
												<ui:FAProgressRing IsIndeterminate="True" Width="20" Height="20" VerticalAlignment="Center" IsVisible="{Binding IsGameSearchLoading}"/>
												<controls:IconButton Command="{Binding ClearSearchCommand}" IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" Icon="X" IconSize="14" Background="Transparent" BorderThickness="0" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,2,0" Padding="8"/>
											</StackPanel>
										</AutoCompleteBox.InnerRightContent>
									</AutoCompleteBox>
<ContentControl Content="{Binding SelectedGame}" ContentTemplate="{StaticResource GameCardTemplate}" IsVisible="{Binding HasSelectedGame}" MaxWidth="360" HorizontalAlignment="Left" />
<controls:CardExpander Header="Join options" Description="Optional instance or private server" IsExpanded="False"><StackPanel Spacing="12" Margin="0,12"><TextBox Text="{Binding ServerId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Server ID or private link"/><Button Content="Join" Command="{Binding JoinServerByIdCommand}"/><Button Content="Private servers" Command="{Binding ShowPrivateServersFromSearchCommand}"/><Button Content="Public servers" Command="{Binding ViewRobloxServersCommand}" CommandParameter="{Binding SelectedGame}" IsEnabled="{Binding HasSelectedGame}" /></StackPanel></controls:CardExpander>
<TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"><TabItem Header="Continue"><ItemsControl ItemsSource="{Binding RecentGames}" ItemTemplate="{StaticResource GameCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveCardGrid MinimumCardWidth="240" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></TabItem><TabItem Header="Discover"><ItemsControl ItemsSource="{Binding RecommendedGames}" ItemTemplate="{StaticResource GameCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveCardGrid MinimumCardWidth="240" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></TabItem><TabItem Header="Favorites"><ItemsControl ItemsSource="{Binding FavoriteGames}" ItemTemplate="{StaticResource GameCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveCardGrid MinimumCardWidth="240" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></TabItem></TabControl>
<TextBlock Text="No games to show yet." IsVisible="{Binding ShowRecentEmpty}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
</StackPanel></controls:SmoothScrollViewer>
</UserControl>
