<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:resources="using:Froststrap.Resources" xmlns:ui="using:FluentAvalonia.UI.Controls" xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings" xmlns:apis="clr-namespace:Froststrap.Models.APIs.Roblox" xmlns:gv="using:Froststrap.UI.ViewModels" xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls" xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia" x:Class="Froststrap.UI.Elements.Settings.Pages.ShortcutsPage" x:DataType="vm:AdvancedSettingsViewModel">
<controls:SmoothScrollViewer><StackPanel Margin="{DynamicResource CoffeePageMargin}" Spacing="18">
<controls:SettingsCardPanel DataContext="{Binding Appearance}" x:DataType="vm:AppearanceViewModel"><controls:OptionControl Header="Theme"><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}"/></controls:OptionControl>
<controls:OptionControl Header="Reduce motion" Description="Use immediate transitions throughout CoffeeStrap."><ToggleSwitch IsChecked="{Binding DisableAnimations, Mode=TwoWay}"/></controls:OptionControl></controls:SettingsCardPanel>
<controls:SettingsCardPanel DataContext="{Binding Deployment}" x:DataType="vm:ChannelViewModel"><controls:OptionControl IsVisible="{x:Static gv:GlobalViewModel.IsLinux}" Header="{x:Static resources:Strings.Menu_Deployment_AutoUpdateSober}">
                <ToggleSwitch IsChecked="{Binding AutomaticallyUpdateSober, Mode=TwoWay}"/>
            </controls:OptionControl>
<controls:OptionControl Header="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxReinstall_Title}" Description="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxReinstall_Description}" IsEnabled="{Binding !IsRobloxInstallationMissing}">
                <ToggleSwitch IsChecked="{Binding ForceRobloxReinstallation, Mode=TwoWay}"/>
            </controls:OptionControl>
<controls:OptionControl IsVisible="{x:Static gv:GlobalViewModel.IsWindowsOrMacOS}" Header="{x:Static resources:Strings.Menu_Channel_RobloxUpgrades}" Description="{x:Static resources:Strings.Menu_Channel_RobloxUpgrades_Description}" IsEnabled="{Binding !IsRobloxInstallationMissing}">
                <ToggleSwitch IsChecked="{Binding UpdateRoblox, Mode=TwoWay}"/>
            </controls:OptionControl>
<controls:CardExpander Header="{x:Static resources:Strings.Menu_Deployment_PlayerOverrideHash_Title}" Description="{x:Static resources:Strings.Menu_Deployment_PlayerOverrideHash_Description}" IsExpanded="{Binding PlayerVersionOverrideEnabled, Mode=OneWay}" Classes="NoUserExpansion" IsVisible="{x:Static gv:GlobalViewModel.IsWindowsOrMacOS}">
                <controls:CardExpander.HeaderContent>
                    <ToggleSwitch IsChecked="{Binding PlayerVersionOverrideEnabled, Mode=TwoWay}"/>
                </controls:CardExpander.HeaderContent>
                <controls:SettingsCardPanel>
                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Deployment_VersionHash_Title}" Description="{x:Static resources:Strings.Menu_Deployment_VersionHash_Description}">
                        <StackPanel Spacing="6">
                            <TextBox Width="280" Margin="8,0,0,0" Padding="10,5" IsEnabled="{Binding PlayerVersionOverrideEnabled}" PlaceholderText="version-xxxxxxxxxxxxxxxx" Text="{Binding PlayerVersionOverrideHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" IsVisible="{Binding !IsPlayerHashIdle}">

                                <ui:FAProgressRing Width="18" Height="18" Margin="0,0,8,0" IsIndeterminate="True" IsVisible="{Binding IsPlayerHashChecking}"/>

                                <Image Source="avares://CoffeeStrap/Resources/MessageBox/Information.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding IsPlayerHashValid}"/>

                                <Image Source="avares://CoffeeStrap/Resources/MessageBox/Error.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding IsPlayerHashInvalid}"/>

                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding PlayerHashValidationMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </controls:OptionControl>

                    <controls:OptionControl Header="Available Version Hashes">
                        <Button Command="{Binding BrowsePlayerVersionHashCommand}" CommandParameter="{Binding $parent[UserControl]}" IsEnabled="{Binding PlayerVersionOverrideEnabled}" Content="Show Available Versions"/>
                    </controls:OptionControl>
                </controls:SettingsCardPanel>
            </controls:CardExpander>
<controls:OptionControl Header="{x:Static resources:Strings.Menu_Deployment_MultiThread_Title}" Description="{x:Static resources:Strings.Menu_Deployment_MultiThread_Description}">
                <TextBox Width="200" Margin="5,0,0,0" Padding="10,5" Text="{Binding MaxThreadDownload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </controls:OptionControl>
<controls:OptionControl Header="{x:Static resources:Strings.Menu_Channel_StaticDirectory_Title}" Description="{x:Static resources:Strings.Menu_Channel_StaticDirectory_Description}">
                <ToggleSwitch IsChecked="{Binding StaticDirectory, Mode=TwoWay}"/>
            </controls:OptionControl>
<controls:CardExpander Header="{x:Static resources:Strings.Menu_Deployment_PlayerChannel_Title}" Description="{x:Static resources:Strings.Menu_Deployment_Channel_Description}" IsVisible="{x:Static gv:GlobalViewModel.IsWindowsOrMacOS}" IsExpanded="True">

                <controls:CardExpander.HeaderContent>
                    <TextBox Width="172" Margin="8,0,0,0" Padding="10,5" IsEnabled="{Binding !PlayerVersionOverrideEnabled}" Text="{Binding PlayerChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </controls:CardExpander.HeaderContent>

                <StackPanel Spacing="8">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding PlayerDeployInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Common_Version}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding PlayerDeployInfo.Version, Mode=OneWay}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Common_VersionGuid}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding PlayerDeployInfo.VersionGuid, Mode=OneWay}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Common_Timestamp}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding PlayerDeployInfo.Timestamp, Mode=OneWay}"/>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0" Orientation="Horizontal" IsVisible="{Binding PlayerShowChannelWarning, Mode=OneWay}">
                            <Image Source="avares://CoffeeStrap/Resources/MessageBox/Warning.png" RenderOptions.BitmapInterpolationMode="HighQuality" Width="24" Height="24"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Deployment_Channel_OutOfDate}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding PlayerDeployInfo, Converter={x:Static ObjectConverters.IsNull}}">
                        <ui:FAProgressRing Grid.Column="0" Width="64" Height="64" Margin="12" IsIndeterminate="True" IsVisible="{Binding !PlayerShowLoadingError, Mode=OneWay}"/>

                        <Image Source="avares://CoffeeStrap/Resources/MessageBox/FullQuality/Error.png" Grid.Column="0" RenderOptions.BitmapInterpolationMode="HighQuality" Margin="6" Width="60" Height="60" IsVisible="{Binding PlayerShowLoadingError, Mode=OneWay}"/>

                        <TextBlock Grid.Column="1" Margin="16" VerticalAlignment="Center" Text="{Binding PlayerInfoLoadingText, Mode=OneWay}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </controls:CardExpander>
<controls:OptionControl Header="{x:Static resources:Strings.Menu_Channel_ChangeAction_Title}" Description="{x:Static resources:Strings.Menu_Channel_ChangeAction_Description}">
                <ComboBox Width="200" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding ChannelChangeModes.Keys, Mode=OneTime}" SelectedItem="{Binding SelectedChannelChangeMode, Mode=TwoWay}"/>
            </controls:OptionControl>

</controls:SettingsCardPanel>
</StackPanel></controls:SmoothScrollViewer>
</UserControl>
