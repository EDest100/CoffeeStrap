<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:Froststrap.UI.Elements.Controls" xmlns:models="using:Froststrap.Models.APIs.Config" xmlns:vm="using:Froststrap.UI.ViewModels.Settings.Mods"
 xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia" x:Class="Froststrap.UI.Elements.Settings.Pages.Mods.CommunityModsPage" x:DataType="vm:CommunityModsViewModel">
<StackPanel Spacing="18">
<TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search community mods" HorizontalAlignment="Stretch" MaxWidth="760" Height="32" MinHeight="0" Padding="14,0" VerticalContentAlignment="Center" />
<ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" />
<StackPanel IsVisible="{Binding HasError}" Spacing="10" HorizontalAlignment="Center"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" /><Button Content="Retry" Command="{Binding RefreshModsCommand}" HorizontalAlignment="Center" /></StackPanel>
<TextBlock Text="No matching mods." IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
<ItemsControl ItemsSource="{Binding Mods}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:ResponsiveCardGrid MinimumCardWidth="250" MaximumColumns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate><DataTemplate x:DataType="models:CommunityMod">
<controls:Card Padding="0" CornerRadius="20" ClipToBounds="True" Height="350"><Grid RowDefinitions="140,Auto,*,Auto" >
<Button HorizontalAlignment="Stretch" Command="{Binding PreviewCommand}" CommandParameter="{Binding $self}" AutomationProperties.Name="Preview mod" ToolTip.Tip="Preview and details" Padding="0" BorderThickness="0" Background="{DynamicResource CoffeeGroupBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="20,20,0,0" ClipToBounds="True"><Grid><ic:Lucide Icon="Image" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Thumbnail}" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" /></Grid></Button>
<TextBlock Grid.Row="1" Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" Margin="14,14,14,8" />
<TextBlock Grid.Row="2" Text="{Binding Description}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" Margin="16,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
<StackPanel Grid.Row="3" Margin="12" Spacing="6"><TextBlock Text="{Binding DownloadError}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><ProgressBar Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloading}" Height="3"/>
    <TextBlock Text="{Binding ApplyHint}" IsVisible="{Binding IsInstalled}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ApplyHint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <Button Content="{Binding DownloadLabel}" Command="{Binding DownloadCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanDownload}" IsVisible="{Binding !IsInstalled}" HorizontalAlignment="Stretch" Height="36"/>
    <Grid IsVisible="{Binding IsInstalled}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !IsDownloading}" HorizontalAlignment="Stretch" Height="36"/>
        <Button Grid.Column="1" Command="{Binding UninstallCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !IsDownloading}" ToolTip.Tip="Uninstall mod" AutomationProperties.Name="Uninstall mod" Width="36" Height="36" Padding="8"><ic:Lucide Icon="Trash" StrokeBrush="{DynamicResource TextFillColorPrimaryBrush}" Width="16" Height="16"/></Button>
    </Grid>
</StackPanel>
</Grid></controls:Card></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></UserControl>
