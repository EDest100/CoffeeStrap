<?xml version="1.0" ?><!-- SPDX-FileCopyrightText: 2026 Froststrap; 2026 CoffeeStrap contributors
 SPDX-License-Identifier: MPL-2.0 --><UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resources="using:Froststrap.Resources" xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings" xmlns:ui="using:FluentAvalonia.UI.Controls" xmlns:gv="using:Froststrap.UI.ViewModels" xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia" xmlns:lucideEnums="clr-namespace:LucideAvalonia.Enum;assembly=LucideAvalonia" x:Class="Froststrap.UI.Elements.Settings.Pages.BehaviourPage" d:DesignHeight="2500" d:DesignWidth="1200" x:DataType="vm:BehaviourViewModel" mc:Ignorable="d">
    <controls:SmoothScrollViewer>
        <controls:SettingsCardPanel Margin="{DynamicResource CoffeePageMargin}">
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Title}" Description="{x:Static resources:Strings.Menu_Behaviour_ConfirmLaunches_Description}">
                <ToggleSwitch IsChecked="{Binding ConfirmLaunches, Mode=TwoWay}"/>
            </controls:OptionControl>

            <controls:CardExpander Header="{x:Static resources:Strings.Menu_Behaviour_EnableVirtualDisplay_Title}" Description="{x:Static resources:Strings.Menu_Behaviour_EnableVirtualDisplay_Description}" IsExpanded="{Binding LaunchWithVirtualDisplay, Mode=TwoWay}" Classes="NoUserExpansion" IsVisible="{x:Static gv:GlobalViewModel.IsMacOS}">
                <controls:CardExpander.HeaderContent>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:Lucide Icon="CircleAlert" VerticalAlignment="Center" StrokeBrush="Orange" ToolTip.Tip="This feature is experimental and may not work as expected."/>
                        <ToggleSwitch IsChecked="{Binding LaunchWithVirtualDisplay, Mode=TwoWay}"/>
                    </StackPanel>
                </controls:CardExpander.HeaderContent>

                <controls:SettingsCardPanel>
                    <controls:OptionControl Header="Name" Description="Customise the metadata what Virtual Display is recognized as">
                        <TextBox Width="200" PlaceholderText="CoffeeStrap Virtual Display" Text="{Binding VirtualDisplayName, Mode=TwoWay}"/>
                    </controls:OptionControl>
                    <controls:OptionControl Header="Width" Description="Customise the screen width (scale is implied to 1 if set, and 0 is default)">
                        <TextBox Width="200" PlaceholderText="CoffeeStrap Virtual Display" Text="{Binding VirtualDisplayWidth, Mode=TwoWay}"/>
                    </controls:OptionControl>
                    <controls:OptionControl Header="Height" Description="Customise the screen height (scale is implied to 1 if set, and 0 is default)">
                        <TextBox Width="200" PlaceholderText="CoffeeStrap Virtual Display" Text="{Binding VirtualDisplayHeight, Mode=TwoWay}"/>
                    </controls:OptionControl>
                    <!-- <controls:OptionControl -->
                        <!-- Header="Display Name" -->
                        <!-- Description="Customise the metadata what Virtual Display is recognized as"> -->
                        <!-- <TextBox -->
                            <!-- Width="200" -->
                            <!-- PlaceholderText="CoffeeStrap Virtual Display" -->
                            <!-- Text="{Binding VirtualDisplayName, Mode=TwoWay}" /> -->
                    <!-- </controls:OptionControl> -->
                </controls:SettingsCardPanel>
            </controls:CardExpander>

            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Behaviour_CloseCrashHandler_Title}" Description="{x:Static resources:Strings.Menu_Behaviour_CloseCrashHandler_Description}" IsVisible="{x:Static gv:GlobalViewModel.IsWindows}">
                <ToggleSwitch IsChecked="{Binding CloseCrashHandler, Mode=TwoWay}"/>
            </controls:OptionControl>





            <controls:CardExpander Header="{x:Static resources:Strings.Menu_Bootstrapper_SoftKey_Title}" Description="{x:Static resources:Strings.Menu_Bootstrapper_SoftKey_Description}" Classes="NoUserExpansion" IsExpanded="{Binding SoftKeyEnabled, Mode=OneWay}" IsVisible="{x:Static gv:GlobalViewModel.IsWindows}">
                <controls:CardExpander.HeaderContent>
                    <ToggleSwitch IsChecked="{Binding SoftKeyEnabled, Mode=TwoWay}"/>
                </controls:CardExpander.HeaderContent>
                <StackPanel>
                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Bootstrapper_SoftKeyProfile_Title}" Description="{x:Static resources:Strings.Menu_Bootstrapper_SoftKeyProfile_Description}">
                        <ComboBox MinWidth="200" ItemsSource="{Binding SoftKeyProfiles}" SelectedItem="{Binding SoftKeyProfile, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:OptionControl>
                </StackPanel>
            </controls:CardExpander>



            <controls:CardExpander Header="{x:Static resources:Strings.Menu_Bootstrapper_AppStorage_Title}" Description="{x:Static resources:Strings.Menu_Bootstrapper_AppStorage_Description}" IsExpanded="True">

                <controls:SettingsCardPanel Margin="0,8,0,0">

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Bootstrapper_RobloxTheme_Title}" Description="{x:Static resources:Strings.Menu_Bootstrapper_RobloxTheme_Description}">
                        <ComboBox MinWidth="200" ItemsSource="{Binding RobloxThemes}" SelectedItem="{Binding RobloxTheme, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding, Converter={StaticResource EnumNameConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:OptionControl>

                    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Bootstrapper_EnableRobloxBackgroundApp_Title}" Description="{x:Static resources:Strings.Menu_Bootstrapper_EnableRobloxBackgroundApp_Description}">
                        <ToggleSwitch IsChecked="{Binding EnableRobloxBackgroundApp, Mode=TwoWay}"/>
                    </controls:OptionControl>
                </controls:SettingsCardPanel>
            </controls:CardExpander>


        </controls:SettingsCardPanel>
    </controls:SmoothScrollViewer>
</UserControl>
