 SPDX-License-Identifier: MPL-2.0 -->
<base:AvaloniaWindow xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Froststrap.UI.Elements.Base" xmlns:controls="clr-namespace:Froststrap.UI.Elements.Controls" xmlns:elements="clr-namespace:Froststrap.UI.Elements" xmlns:gv="using:Froststrap.UI.ViewModels" xmlns:ico="using:FluentIcons.Avalonia.Fluent" xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia" xmlns:local="clr-namespace:Froststrap.UI.Elements.Settings" xmlns:enums="using:Froststrap.Enums" xmlns:resources="using:Froststrap.Resources" xmlns:av="using:Avalonia.Controls" xmlns:transitions="clr-namespace:Froststrap.UI.Utility" xmlns:ui="using:FluentAvalonia.UI.Controls" xmlns:vm="clr-namespace:Froststrap.UI.ViewModels.Settings" x:Class="Froststrap.UI.Elements.Settings.MainWindow" Title="{x:Static resources:Strings.Menu_Title}" Width="1125" Height="700" MinWidth="750" MinHeight="415" x:DataType="vm:MainWindowViewModel" CanResize="True" WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="52,*,Auto,74" Background="{DynamicResource CoffeeChromeBrush}">
        <controls:TitleBar Grid.Row="0" Height="52" Title="CoffeeStrap" Icon="avares://CoffeeStrap/CoffeeStrap.png"><controls:TitleBar.CenterContent><ItemsControl IsVisible="{Binding HasBreadcrumbs}" ItemsSource="{Binding BreadcrumbItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:BreadcrumbItemModel">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                                    <Button Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BreadcrumbItemClickedCommand}" CommandParameter="{Binding}" Content="{Binding Content}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" IsVisible="{Binding !IsLast}"/>
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsVisible="{Binding !IsLast}" Text="›"/>
                                                    <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" IsVisible="{Binding IsLast}" Text="{Binding Content}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl></controls:TitleBar.CenterContent></controls:TitleBar>

        <controls:CoffeeNavigationView Name="NavView" Grid.Row="1" Background="{DynamicResource CoffeeChromeBrush}" ItemInvoked="NavView_ItemInvoked" OpenPaneLength="232" CompactPaneLength="68" IsPaneOpen="False">

            <controls:CoffeeNavigationView.PaneToggleRowContent><controls:InlineSettingsSearch Name="SettingsSearch" DataContext="{Binding SearchBar}"/></controls:CoffeeNavigationView.PaneToggleRowContent>

            <controls:CoffeeNavigationView.MenuItems/>

            <controls:CoffeeNavigationView.FooterMenuItems>
                <controls:CoffeeNavigationItem Content="{x:Static resources:Strings.Menu_About_Title}" Tag="about">
                    <controls:CoffeeNavigationItem.Icon>
                        <ic:Lucide Icon="CircleAlert"/>
                    </controls:CoffeeNavigationItem.Icon>
                </controls:CoffeeNavigationItem>
            </controls:CoffeeNavigationView.FooterMenuItems>

            <controls:CoffeeNavigationView.Content><Panel><TransitioningContentControl x:Name="PageContentControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <TransitioningContentControl.PageTransition>
                                <transitions:CoffeePageTransition/>
                            </TransitioningContentControl.PageTransition>
                        </TransitioningContentControl></Panel></controls:CoffeeNavigationView.Content>
        </controls:CoffeeNavigationView>

        <controls:AnimatedReveal x:Name="SaveErrorReveal" Grid.Row="2" IsExpanded="{Binding HasSaveError}">
            <Border Margin="16,0,16,10" Padding="12" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4"><TextBlock Text="Settings need attention" FontWeight="SemiBold"/><TextBlock x:Name="SaveErrorText" Text="{Binding SaveError}" TextWrapping="Wrap" FontSize="12"/></StackPanel>
                    <Button x:Name="RetrySaveButton" Grid.Column="1" Content="Retry save" Command="{Binding SaveSettingsCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </controls:AnimatedReveal>

        <Border Grid.Row="3" Height="74" Padding="0,0,16,0" Background="{DynamicResource CoffeeChromeBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefault}" BorderThickness="0">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto" ColumnSpacing="8">
                <local:AccountSelectorView x:Name="AccountSelectorView" Grid.Column="0" Margin="8,0,0,0"/>
                <controls:IconButton Grid.Column="2" FontWeight="SemiBold" Height="36" Padding="20,0" Classes="DropDownButton Primary" Command="{Binding SaveAndLaunchSettingsCommand}" Content="{Binding LaunchButtonText}" IsVisible="{Binding !IsHome}">
                    <controls:IconButton.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuItem Header="{Binding PlayerMenuItemText}" Command="{Binding SetLaunchModeCommand}" CommandParameter="{x:Static enums:LaunchMode.Player}">
                                <MenuItem.Icon>
                                    <ic:Lucide Icon="Gamepad2"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static resources:Strings.Common_Studio}" Command="{Binding SetLaunchModeCommand}" CommandParameter="{x:Static enums:LaunchMode.Studio}">
                                <MenuItem.Icon>
                                    <ic:Lucide Icon="Wrench"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </controls:IconButton.Flyout>
                </controls:IconButton>
                <Button FontWeight="SemiBold" Grid.Column="3" Height="36" Padding="20,0" Command="{Binding RestartAppCommand}" Content="{x:Static resources:Strings.Menu_Restart}" IsVisible="{Binding !IsHome}"/>
                <Button FontWeight="SemiBold" Grid.Column="4" Height="36" Padding="20,0" Classes="accent" Command="{Binding SaveSettingsCommand}" Content="{x:Static resources:Strings.Menu_Save}" IsVisible="{Binding !IsHome}"/>
                <Button FontWeight="SemiBold" Grid.Column="5" Height="36" Padding="20,0" Command="{Binding CloseWindowCommand}" Content="{x:Static resources:Strings.Common_Close}" IsVisible="{Binding !IsHome}"/>
            </Grid>
        </Border>

        <Panel Name="NotificationPanel" Grid.Row="0" Grid.RowSpan="4" Margin="0,50,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" ZIndex="1000"/>

        <Border x:Name="OffscreenIndexingCanvas" Grid.Row="1" Grid.Column="1" Width="905" Height="700" IsHitTestVisible="False" IsVisible="False" Opacity="0" ZIndex="-1000"/>


    </Grid>
</base:AvaloniaWindow>
