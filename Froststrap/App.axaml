<Application
    x:Class="Froststrap.App"
    Name="CoffeeStrap"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
    xmlns:sty="using:FluentAvalonia.Styling"
    xmlns:converters="using:Froststrap.UI.Converters"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    RequestedThemeVariant="Dark"
>
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem
                Header="About CoffeeStrap"
                Click="About_OnClick"
            />

            <NativeMenuItemSeparator />

            <NativeMenuItem
                Header="Settings"
                Click="Settings_OnClick"
                Gesture="Meta+,"
            />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="False" PreferUserAccentColor="False" CustomAccentColor="#D7AD84" />

        <StyleInclude Source="avares://CoffeeStrap/UI/Elements/Controls/Hyperlink.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/Elements/Controls/OptionControl.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/Elements/Controls/SquareCard.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/Elements/Controls/Card.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/Elements/Controls/CardExpander.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/Elements/Controls/TitleBar.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/Elements/Controls/CoffeeNavigationView.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/Elements/Controls/CardAction.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/Elements/Controls/IconButton.axaml" />

        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <StyleInclude Source="avares://CoffeeStrap/UI/AppThemes/Default.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/AppThemes/CoffeeStrap.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/AppThemes/ModernSettings.axaml" />
        <StyleInclude Source="avares://CoffeeStrap/UI/AppThemes/Revision3.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ColorPicker/Templates/HueSlider.axaml" />
                <ResourceInclude Source="avares://ColorPicker/Templates/SquareSlider.axaml" />
                <ResourceInclude Source="avares://ColorPicker/Templates/SquarePicker.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <StaticResource x:Key="ToolTipBackground" ResourceKey="ToolTipBackgroundBrush" />
            <StaticResource x:Key="ToolTipForeground" ResourceKey="ToolTipForegroundBrush" />

            <FontFamily x:Key="Rubik">avares://CoffeeStrap/Resources/Fonts/Rubik-VariableFont_wght.ttf</FontFamily>
            <FontFamily x:Key="BuilderIconsRegular">avares://CoffeeStrap/Resources/Fonts#BuilderIcons-Regular</FontFamily>
            <FontFamily x:Key="BuilderIconsFilled">avares://CoffeeStrap/Resources/Fonts#BuilderIcons-Filled</FontFamily>

            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:EnumNameConverter x:Key="EnumNameConverter" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <converters:NumberAbbreviationConverter x:Key="NumberAbbreviationConverter" />
            <converters:UrlToBitmapConverter x:Key="UrlToBitmapConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
